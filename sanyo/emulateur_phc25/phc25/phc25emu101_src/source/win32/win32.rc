/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_ICON                ICON                    "icon.ico"
IDI_SMALL               ICON                    "small.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDC_MENU MENU 
BEGIN
    POPUP "File"
    BEGIN
        POPUP "Read tape options"
        BEGIN
            MENUITEM "Read tape file",                      ID_SET_READTAPE
            MENUITEM "Rewind",                    ID_REW_READTAPE
        END
        POPUP "Write tape options"
        BEGIN
            MENUITEM "Write tape file",                      ID_SET_WRITETAPE
        END
        MENUITEM "Reset",                    ID_RESET
        MENUITEM "Exit (&X)",         IDM_EXIT
    END
    POPUP "System"
    BEGIN
        POPUP "Video options"
        BEGIN
            POPUP "screen size"
            BEGIN
                MENUITEM "x1",                          ID_WINDOWSIZEx1
                MENUITEM "x2",                          ID_WINDOWSIZEx2
                MENUITEM "x3",                          ID_WINDOWSIZEx3
                MENUITEM "x4",                          ID_WINDOWSIZEx4
                MENUITEM "Fullscreen",              ID_FULLSCREEN
            END
            POPUP "Skip frame"
            BEGIN
                MENUITEM "on",                        ID_FRAMESKIP_ON
                MENUITEM "off",                        ID_FRAMESKIP_OFF
            END
            MENUITEM "status bar",              ID_DRAW_STATUS
            MENUITEM "TV frame",                ID_DRAW_TV
        END
        POPUP "Sound"
        BEGIN
            POPUP "Volume"
            BEGIN
                MENUITEM "100%",                        ID_SOUND_VOL100
                MENUITEM "90%",                         ID_SOUND_VOL90
                MENUITEM "80%",                         ID_SOUND_VOL80
                MENUITEM "70%",                         ID_SOUND_VOL70
                MENUITEM "60%",                         ID_SOUND_VOL60
                MENUITEM "50%",                         ID_SOUND_VOL50
                MENUITEM "40%",                         ID_SOUND_VOL40
                MENUITEM "30%",                         ID_SOUND_VOL30
                MENUITEM "20%",                         ID_SOUND_VOL20
                MENUITEM "10%",                         ID_SOUND_VOL10
                MENUITEM "mute",                        ID_SOUND_MUTE
            END
            POPUP "Latency"
            BEGIN
                MENUITEM "10ms",                        ID_SOUND_BUF10
                MENUITEM "15ms",                        ID_SOUND_BUF10
                MENUITEM "20ms",                        ID_SOUND_BUF20
                MENUITEM "25ms",                        ID_SOUND_BUF25
                MENUITEM "30ms",                        ID_SOUND_BUF30
                MENUITEM "35ms",                        ID_SOUND_BUF35
                MENUITEM "40ms",                        ID_SOUND_BUF40
                MENUITEM "45ms",                        ID_SOUND_BUF45
                MENUITEM "50ms",                        ID_SOUND_BUF50
                MENUITEM "75ms",                        ID_SOUND_BUF75
                MENUITEM "100ms",                       ID_SOUND_BUF100
                MENUITEM "125ms",                       ID_SOUND_BUF125
                MENUITEM "150ms",                       ID_SOUND_BUF150
                MENUITEM "200ms",                       ID_SOUND_BUF200
                MENUITEM "500ms",                       ID_SOUND_BUF500
            END
        END
        MENUITEM "Set printer",                    ID_SETPRINTER
    END
    POPUP "Help"
    BEGIN
        MENUITEM "About",         IDM_ABOUT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDC_KEY ACCELERATORS 
BEGIN
    "/",            IDM_ABOUT,              ASCII,  ALT, NOINVERT
    "?",            IDM_ABOUT,              ASCII,  ALT, NOINVERT
    VK_RETURN,      IDM_CHANGESCREEN,       VIRTKEY, ALT, NOINVERT
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 22, 17, 179, 59
STYLE DS_SETFONT | DS_MODALFRAME | WS_CAPTION | WS_SYSMENU
CAPTION "About"
FONT 8, "System", 0, 0, 0x0
BEGIN
    ICON            IDI_ICON,IDC_MYICON,4,4,20,20
    LTEXT           "PHC-25 Emulator Version 1.01",IDC_STATIC,26,4,107,8,
                    SS_NOPREFIX
    LTEXT           "Copyright (C) 2004 by TAGO",IDC_STATIC,26,14,101,8
    LTEXT           "Converted for PAL by G.Fetis 2007",IDC_STATIC,26,24,101,8
    DEFPUSHBUTTON   "OK",IDOK,135,22,40,11,WS_GROUP
END


